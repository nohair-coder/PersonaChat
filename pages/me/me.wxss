.me-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 48rpx;
}

/* Guest state */
.guest-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 64rpx;
}

.guest-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  margin-bottom: 32rpx;
  background: #e5e5e5;
}

.guest-tip {
  font-size: 30rpx;
  color: #666666;
  margin-bottom: 48rpx;
  text-align: center;
}

.guest-login-btn {
  width: 400rpx;
}

/* User card */
.user-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 32rpx 32rpx;
  margin-bottom: 24rpx;
  gap: 24rpx;
}

.user-info {
  flex: 1;
  overflow: hidden;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.edit-btn {
  font-size: 26rpx;
  color: #0052d9;
}

.nickname-edit-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.edit-actions {
  display: flex;
  gap: 24rpx;
}

.cancel-btn {
  font-size: 28rpx;
  color: #999999;
}

.save-btn {
  font-size: 28rpx;
  color: #0052d9;
  font-weight: bold;
}

/* Section title */
.section-title {
  font-size: 26rpx;
  color: #999999;
  padding: 20rpx 32rpx 8rpx;
}

/* Sessions */
.sessions-loading {
  display: flex;
  justify-content: center;
  padding: 48rpx;
}

.sessions-list {
  margin-bottom: 24rpx;
}

.session-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.session-time {
  font-size: 22rpx;
  color: #cccccc;
}

.delete-btn {
  font-size: 24rpx;
  color: #ff4d4f;
}

.cell-hover {
  background: #f0f4ff;
}

/* Logout */
.logout-btn {
  margin: 48rpx 32rpx 0;
  width: calc(100% - 64rpx);
  color: #ff4d4f;
  border-color: #ff4d4f;
}
