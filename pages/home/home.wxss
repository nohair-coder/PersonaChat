page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.search-wrap {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #fff;
  padding: 8rpx 0;
}

/* Loading */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

/* Error */
.error-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.error-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.retry-btn {
  background-color: #0052d9;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1.5;
}

.retry-btn::after {
  border: none;
}

/* Section titles */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding: 24rpx 32rpx 12rpx;
}

.section-title--list {
  padding-top: 32rpx;
}

/* Featured swiper */
.featured-swiper {
  width: 100%;
  height: 360rpx;
  margin-bottom: 4rpx;
}

.swiper-item {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

.swiper-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
}

.swiper-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}

.swiper-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Persona grid */
.persona-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx 32rpx;
  gap: 0;
}
